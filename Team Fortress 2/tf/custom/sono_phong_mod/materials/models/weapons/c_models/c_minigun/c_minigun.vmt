"VertexLitGeneric"
{
	"$basetexture" "models/weapons/c_models/c_minigun/c_minigun"
//	"$phongexponenttexture" "models/weapons/c_models/c_minigun/c_minigun_exp"
	"$bumpmap"	"models/weapons/c_minigun/c_minigun_phongmask"
	
	"$phong" "1"
	//commented out to use the exponent mask
	"$phongexponent" "15"
	"$phongboost" "5"	
//	"$phongalbedotint" "1"
	
	//scales up the exponent texture which usually only has about 120 levels of exponent
//	"$phongexponentfactor"  "80"
	
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"
	"$basephongexponent" "15"
	"$basephongboost" "5"		
	"$phongfresnelranges"	"[1.5 .5 3]"
	"$halflambert" "1"
	"$glowcolor" "1"
	
	"$commadd_phongexponent" "30"
	"$commadd_phongboost" 	"22.5"
	"$commweapon"		"0"
	
	"$envmap" "env_cubemap"
	"$envmaptint" "[.025 .025 .025]"

	"$tempvar" "0"
	

	//commented out to use the exponent mask
	//"$basephongexponent" "15"
	//"$basephongboost" "3"

	"$basemapalphaphongmask" "1"
	
	"$rimlight" "1"						
	"$rimlightexponent" "20"				
	"$rimlightboost" ".25"
	"$rimmask" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	
	
		"WeaponSkin" {
			
		}
	}
}